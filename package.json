{
  "name": "mediacord",
  "version": "2.0.0",
  "description": "Universal Discord Rich Presence for VLC, IINA, and other media players with automatic movie/TV show detection",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/main.js",
    "dev": "nodemon src/main.js --ignore public/",
    "test": "node test-platform.js",
    "test:compat": "node test-platform.js",
    "health": "node -e \"fetch('http://localhost:7100/health').then(r=>r.json()).then(console.log)\"",
    "lint": "echo 'Linting not configured yet'"
  },
  "keywords": [
    "discord",
    "vlc",
    "iina",
    "media-player",
    "rich-presence",
    "tmdb",
    "rpc",
    "automation",
    "entertainment",
    "macos",
    "universal"
  ],
  "author": {
    "name": "canna-dev",
