  },
  "homepage": "https://github.com/canna-dev/mediacord#readme",
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "discord-rpc": "^4.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
